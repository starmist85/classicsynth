#include <winres.h>
#include "resource.h"
#include "../src/version.h"

IDR_LOGO_PNG RCDATA "..\\..\\assets\\logo.png"
IDR_BG_PNG   RCDATA "..\\..\\assets\\bg.png"
IDR_SPLASH_PNG RCDATA "..\\..\\assets\\classicSynth.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    CS_VERSION_MAJOR, CS_VERSION_MINOR, CS_VERSION_PATCH, CS_VERSION_BUILD
 PRODUCTVERSION CS_VERSION_MAJOR, CS_VERSION_MINOR, CS_VERSION_PATCH, CS_VERSION_BUILD
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      CS_VENDOR
            VALUE "FileDescription",  CS_FULL_NAME " (VST3)"
            VALUE "FileVersion",      CS_VERSION_STR
            VALUE "InternalName",     CS_PRODUCT
            VALUE "OriginalFilename", "ClassicSynth.vst3"
            VALUE "ProductName",      CS_FULL_NAME
            VALUE "ProductVersion",   CS_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
