<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{6B1F4C2A-3E7D-4F0B-9A51-2C8D7E4F1A01}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>ClassicSynth</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup>
    <TargetName>ClassicSynth</TargetName>
    <TargetExt>.vst3</TargetExt>
    <OutDir>$(ProjectDir)build\$(Configuration)\bin\</OutDir>
    <IntDir>$(ProjectDir)build\$(Configuration)\obj\</IntDir>
    <BundleDir>$(ProjectDir)build\$(Configuration)\ClassicSynth.vst3\</BundleDir>
    <SdkDir>$(ProjectDir)external\vst3sdk\</SdkDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalIncludeDirectories>$(SdkDir);$(ProjectDir)external\miniz;$(ProjectDir)src;$(ProjectDir)resources;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NOMINMAX;_CRT_SECURE_NO_WARNINGS;_USE_MATH_DEFINES;MINIZ_NO_TIME;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/utf-8 /bigobj %(AdditionalOptions)</AdditionalOptions>
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions2</EnableEnhancedInstructionSet>
      <FloatingPointModel>Fast</FloatingPointModel>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>d2d1.lib;dwrite.lib;windowscodecs.lib;comdlg32.lib;shell32.lib;ole32.lib;shlwapi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>if not exist "$(BundleDir)Contents\x86_64-win" mkdir "$(BundleDir)Contents\x86_64-win"
if not exist "$(BundleDir)Contents\Resources\Presets" mkdir "$(BundleDir)Contents\Resources\Presets"
copy /Y "$(TargetPath)" "$(BundleDir)Contents\x86_64-win\ClassicSynth.vst3" &gt; nul
if exist "$(BundleDir)desktop.ini" attrib -h -s "$(BundleDir)desktop.ini"
if exist "$(BundleDir)PlugIn.ico" attrib -h -s "$(BundleDir)PlugIn.ico"
copy /Y "$(ProjectDir)resources\desktop.ini" "$(BundleDir)desktop.ini" &gt; nul
if exist "$(ProjectDir)..\assets\PlugIn.ico" (copy /Y "$(ProjectDir)..\assets\PlugIn.ico" "$(BundleDir)PlugIn.ico" &gt; nul) else (copy /Y "$(ProjectDir)resources\PlugIn.ico" "$(BundleDir)PlugIn.ico" &gt; nul)
attrib +h +s "$(BundleDir)desktop.ini"
attrib +h "$(BundleDir)PlugIn.ico"
attrib +s "$(BundleDir)"
rem Factory presets for development builds: junctions to the repository folders.
if not exist "$(BundleDir)Contents\Resources\Presets\Library" if exist "$(ProjectDir)..\presets" mklink /J "$(BundleDir)Contents\Resources\Presets\Library" "$(ProjectDir)..\presets" &gt; nul
if not exist "$(BundleDir)Contents\Resources\Presets\Zip Banks" if exist "$(ProjectDir)..\zipbank" mklink /J "$(BundleDir)Contents\Resources\Presets\Zip Banks" "$(ProjectDir)..\zipbank" &gt; nul
echo Bundle: $(BundleDir)</Command>
      <Message>Assembling VST3 bundle</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>DEVELOPMENT=1;_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>RELEASE=1;NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

